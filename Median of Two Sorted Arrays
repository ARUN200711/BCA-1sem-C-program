#include <limits.h>

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }

    int low = 0, high = nums1Size;
    int totalLeft = (nums1Size + nums2Size + 1) / 2;

    while (low <= high) {
        int i = low + (high - low) / 2;
        int j = totalLeft - i;

        int nums1LeftMax  = (i == 0) ? INT_MIN : nums1[i - 1];
        int nums1RightMin = (i == nums1Size) ? INT_MAX : nums1[i];
        int nums2LeftMax  = (j == 0) ? INT_MIN : nums2[j - 1];
        int nums2RightMin = (j == nums2Size) ? INT_MAX : nums2[j];

        if (nums1LeftMax <= nums2RightMin && nums2LeftMax <= nums1RightMin) {
            int maxLeft = (nums1LeftMax > nums2LeftMax) ? nums1LeftMax : nums2LeftMax;
            if ((nums1Size + nums2Size) % 2 == 1) {
                return (double)maxLeft;
            }
            int minRight = (nums1RightMin < nums2RightMin) ? nums1RightMin : nums2RightMin;
            return (maxLeft + minRight) / 2.0;
        } else if (nums1LeftMax > nums2RightMin) {
            high = i - 1;
        } else {
            low = i + 1;
        }
    }

    return 0.0;
}
